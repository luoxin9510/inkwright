// member_get(1, "hp") or member_get("knight", …) reads <var>_<member> (any variable the story declares per member too); party_count("<var>", value) counts the members whose variable equals value. Done by the engine: far cheaper than a switch in ink.
EXTERNAL member_get(member, var_name)
EXTERNAL party_count(var_name, match)
=== function member_get(member, var_name) ===
{ member == 1 or member == "knight":
    { var_name == "hp":
        ~ return hp_knight
    }
    { var_name == "hp_max":
        ~ return hp_max_knight
    }
    { var_name == "mp":
        ~ return mp_knight
    }
    { var_name == "mp_max":
        ~ return mp_max_knight
    }
    { var_name == "atk":
        ~ return atk_knight
    }
    { var_name == "def":
        ~ return def_knight
    }
    { var_name == "spd":
        ~ return spd_knight
    }
    { var_name == "art":
        ~ return art_knight
    }
    { var_name == "acted":
        ~ return acted_knight
    }
    { var_name == "title":
        ~ return title_knight
    }
    ~ return 0
}
{ member == 2 or member == "mage":
    { var_name == "hp":
        ~ return hp_mage
    }
    { var_name == "hp_max":
        ~ return hp_max_mage
    }
    { var_name == "mp":
        ~ return mp_mage
    }
    { var_name == "mp_max":
        ~ return mp_max_mage
    }
    { var_name == "atk":
        ~ return atk_mage
    }
    { var_name == "def":
        ~ return def_mage
    }
    { var_name == "spd":
        ~ return spd_mage
    }
    { var_name == "art":
        ~ return art_mage
    }
    { var_name == "acted":
        ~ return acted_mage
    }
    { var_name == "title":
        ~ return title_mage
    }
    ~ return 0
}
{ member == 3 or member == "cleric":
    { var_name == "hp":
        ~ return hp_cleric
    }
    { var_name == "hp_max":
        ~ return hp_max_cleric
    }
    { var_name == "mp":
        ~ return mp_cleric
    }
    { var_name == "mp_max":
        ~ return mp_max_cleric
    }
    { var_name == "atk":
        ~ return atk_cleric
    }
    { var_name == "def":
        ~ return def_cleric
    }
    { var_name == "spd":
        ~ return spd_cleric
    }
    { var_name == "art":
        ~ return art_cleric
    }
    { var_name == "acted":
        ~ return acted_cleric
    }
    { var_name == "title":
        ~ return title_cleric
    }
    ~ return 0
}
{ var_name == "title":
    ~ return ""
}
~ return 0

