{ who_id == "knight":
    ~ return
}
{ who_id == "mage":
    ~ return
}
{ who_id == "cleric":
    ~ return
}
{ ent_has(foe, who_id):
    ~ foe = ent_drop(foe, who_id)
    ~ clear_status(who_id, "")
    ~ return
}

=== function alive(kind) ===
~ temp pick_no = 0
{ kind == "party":
    ~ pick_no = 0
    { hp_knight > 0:
        ~ pick_no = pick_no + 1
    }
    { hp_mage > 0:
        ~ pick_no = pick_no + 1
    }
    { hp_cleric > 0:
        ~ pick_no = pick_no + 1
    }
    ~ return pick_no
}
{ kind == "foe":
    ~ return ent_count(foe)
}
~ return 0

=== function pick_one(kind, how) ===
~ temp pick_no = 0
~ temp new_id = ""
{ kind == "party":
    ~ pick_no = 0
    { hp_knight > 0:
        ~ pick_no = pick_no + 1
    }
    { hp_mage > 0:
        ~ pick_no = pick_no + 1
    }
    { hp_cleric > 0:
        ~ pick_no = pick_no + 1
    }
    { pick_no <= 0:
        ~ return ""
    }
    { how == "lowest:hp":
        ~ new_id = ""
        { hp_knight > 0 and (new_id == "" or hp_knight < stat(new_id, "hp")):
            ~ new_id = "knight"
        }
        { hp_mage > 0 and (new_id == "" or hp_mage < stat(new_id, "hp")):
            ~ new_id = "mage"
        }
        { hp_cleric > 0 and (new_id == "" or hp_cleric < stat(new_id, "hp")):
            ~ new_id = "cleric"
        }
        ~ return new_id
    }
    { how == "lowest:hp_max":
        ~ new_id = ""
        { hp_knight > 0 and (new_id == "" or hp_max_knight < stat(new_id, "hp_max")):
            ~ new_id = "knight"
        }
        { hp_mage > 0 and (new_id == "" or hp_max_mage < stat(new_id, "hp_max")):
            ~ new_id = "mage"
        }
        { hp_cleric > 0 and (new_id == "" or hp_max_cleric < stat(new_id, "hp_max")):
