// Generated by Inkwright from the game's notes. Do not edit; regenerate.
INCLUDE ../rules.ink

LIST characters = party
VAR character = party

// Skills of the current character (loaded by pick_character)
VAR wits = 0

// Resources
VAR potions = 2

// Dice: the engine sets these; saved with the state, so back/load/replay roll the same
VAR dice_seed = 0
VAR dice_rolls = 0

// Text in the story's language: {t("zh…", "en…")}; the play panel switches lang.
VAR lang = "zh"

=== function t(zh, en) ===
{ lang == "en":
    ~ return en
}
~ return zh

// Party: hp_knight is a member's hp, title_knight a line the panel shows under the name.
VAR hp_knight = 18
VAR hp_max_knight = 18
VAR mp_knight = 4
VAR mp_max_knight = 4
VAR atk_knight = 4
VAR def_knight = 2
VAR spd_knight = 3
