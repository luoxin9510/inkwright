    { how == "highest:mp":
        ~ new_id = ""
        { hp_knight > 0 and (new_id == "" or mp_knight > stat(new_id, "mp")):
            ~ new_id = "knight"
        }
        { hp_mage > 0 and (new_id == "" or mp_mage > stat(new_id, "mp")):
            ~ new_id = "mage"
        }
        { hp_cleric > 0 and (new_id == "" or mp_cleric > stat(new_id, "mp")):
            ~ new_id = "cleric"
        }
        ~ return new_id
    }
    { how == "highest:mp_max":
        ~ new_id = ""
        { hp_knight > 0 and (new_id == "" or mp_max_knight > stat(new_id, "mp_max")):
            ~ new_id = "knight"
        }
        { hp_mage > 0 and (new_id == "" or mp_max_mage > stat(new_id, "mp_max")):
            ~ new_id = "mage"
        }
        { hp_cleric > 0 and (new_id == "" or mp_max_cleric > stat(new_id, "mp_max")):
            ~ new_id = "cleric"
        }
        ~ return new_id
    }
    { how == "highest:atk":
        ~ new_id = ""
        { hp_knight > 0 and (new_id == "" or atk_knight > stat(new_id, "atk")):
            ~ new_id = "knight"
        }
        { hp_mage > 0 and (new_id == "" or atk_mage > stat(new_id, "atk")):
            ~ new_id = "mage"
        }
        { hp_cleric > 0 and (new_id == "" or atk_cleric > stat(new_id, "atk")):
            ~ new_id = "cleric"
        }
        ~ return new_id
    }
    { how == "highest:def":
        ~ new_id = ""
        { hp_knight > 0 and (new_id == "" or def_knight > stat(new_id, "def")):
            ~ new_id = "knight"
        }
        { hp_mage > 0 and (new_id == "" or def_mage > stat(new_id, "def")):
            ~ new_id = "mage"
        }
        { hp_cleric > 0 and (new_id == "" or def_cleric > stat(new_id, "def")):
            ~ new_id = "cleric"
        }
        ~ return new_id
    }
    { how == "highest:spd":
        ~ new_id = ""
        { hp_knight > 0 and (new_id == "" or spd_knight > stat(new_id, "spd")):
            ~ new_id = "knight"
        }
        { hp_mage > 0 and (new_id == "" or spd_mage > stat(new_id, "spd")):
            ~ new_id = "mage"
        }
        { hp_cleric > 0 and (new_id == "" or spd_cleric > stat(new_id, "spd")):
            ~ new_id = "cleric"
        }
        ~ return new_id
    }
    { how == "highest:art":
        ~ new_id = ""
        { hp_knight > 0 and (new_id == "" or art_knight > stat(new_id, "art")):
            ~ new_id = "knight"
        }
        { hp_mage > 0 and (new_id == "" or art_mage > stat(new_id, "art")):
            ~ new_id = "mage"
        }
        { hp_cleric > 0 and (new_id == "" or art_cleric > stat(new_id, "art")):
            ~ new_id = "cleric"
        }
        ~ return new_id
    }
    { how == "highest:acted":
        ~ new_id = ""
        { hp_knight > 0 and (new_id == "" or acted_knight > stat(new_id, "acted")):
            ~ new_id = "knight"
        }
        { hp_mage > 0 and (new_id == "" or acted_mage > stat(new_id, "acted")):
            ~ new_id = "mage"
        }
        { hp_cleric > 0 and (new_id == "" or acted_cleric > stat(new_id, "acted")):
            ~ new_id = "cleric"
        }
        ~ return new_id
    }
    {
    - how == "first" or pick_no == 1:
        ~ pick_no = 1
    - how == "last":
        ~ pick_no = pick_no
    - how == "random":
        ~ pick_no = roll_dice("1d" + pick_no, "pick:party")
    - else:
        ~ pick_no = 0
    }
    ~ return nth_one(kind, pick_no)
}
{ kind == "foe":
    { how == "random":
        ~ pick_no = ent_count(foe)
        { pick_no <= 0:
            ~ return ""
        }
        { pick_no == 1:
            ~ return ent_at(foe, 1)
        }
        ~ return ent_at(foe, roll_dice("1d" + pick_no, "pick:foe"))
    }
    ~ return ent_pick(foe, how)
}
~ return ""

=== function nth_one(kind, amount) ===
~ temp pick_no = 0
{ kind == "party":
    ~ pick_no = 0
    { hp_knight > 0:
        ~ pick_no = pick_no + 1
        { pick_no == amount:
            ~ return "knight"
        }
    }
    { hp_mage > 0:
        ~ pick_no = pick_no + 1
        { pick_no == amount:
            ~ return "mage"
        }
    }
    { hp_cleric > 0:
        ~ pick_no = pick_no + 1
        { pick_no == amount:
            ~ return "cleric"
        }
    }
    ~ return ""
}
{ kind == "foe":
    ~ return ent_at(foe, amount)
}
~ return ""

=== function name_of(who_id) ===
{ who_id == "knight":
    ~ return t("骑士", "Knight")
}
{ who_id == "mage":
    ~ return t("法师", "Mage")
}
{ who_id == "cleric":
    ~ return t("牧师", "Cleric")
}
{ ent_has(foe, who_id):
    ~ return ent_name(foe, "foe", who_id)
}
~ return who_id
