{ ent_has(foe, who_id):
    ~ foe = ent_set(foe, who_id, stat_id, amount, "hp")
    { not ent_has(foe, who_id):
        ~ clear_status(who_id, "")
    }
    ~ return
}

=== function add_stat(who_id, stat_id, amount) ===
~ set_stat(who_id, stat_id, stat(who_id, stat_id) + amount)

