// Generated by Inkwright from the game's notes. Do not edit; regenerate.
INCLUDE ../rules.ink

LIST characters = crew
VAR character = crew

// Skills of the current character (loaded by pick_character)
VAR wits = 0

// Resources
VAR torches = 6
VAR potions = 2
VAR gold = 0

// Dice: the engine sets these; saved with the state, so back/load/replay roll the same
VAR dice_seed = 0
VAR dice_rolls = 0

// Text in the story's language: {t("zh…", "en…")}; the play panel switches lang.
VAR lang = "zh"

=== function t(zh, en) ===
{ lang == "en":
    ~ return en
}
~ return zh

// Party: life_blade is a member's life, title_blade a line the panel shows under the name.
VAR life_blade = 6
VAR life_max_blade = 6
VAR might_blade = 2
VAR guard_blade = 1
VAR title_blade = ""
VAR life_archer = 5
VAR life_max_archer = 5
VAR might_archer = 2
VAR guard_archer = 0
VAR title_archer = ""
VAR life_shield = 7
VAR life_max_shield = 7
VAR might_shield = 1
VAR guard_shield = 2
VAR title_shield = ""
VAR life_scholar = 4
VAR life_max_scholar = 4
VAR might_scholar = 1
VAR guard_scholar = 0
VAR title_scholar = ""

// member_get(1, "life") or member_get("blade", …) reads <var>_<member> (any variable the story declares per member too); party_count("<var>", value) counts the members whose variable equals value. Done by the engine: far cheaper than a switch in ink.
EXTERNAL member_get(member, var_name)
EXTERNAL party_count(var_name, match)
=== function member_get(member, var_name) ===
{ member == 1 or member == "blade":
    { var_name == "life":
        ~ return life_blade
    }
    { var_name == "life_max":
        ~ return life_max_blade
    }
    { var_name == "might":
        ~ return might_blade
    }
    { var_name == "guard":
        ~ return guard_blade
    }
    { var_name == "title":
        ~ return title_blade
    }
    ~ return 0
}
{ member == 2 or member == "archer":
    { var_name == "life":
        ~ return life_archer
    }
    { var_name == "life_max":
        ~ return life_max_archer
    }
    { var_name == "might":
        ~ return might_archer
    }
    { var_name == "guard":
        ~ return guard_archer
    }
    { var_name == "title":
        ~ return title_archer
    }
    ~ return 0
}
{ member == 3 or member == "shield":
    { var_name == "life":
        ~ return life_shield
    }
    { var_name == "life_max":
        ~ return life_max_shield
    }
    { var_name == "might":
        ~ return might_shield
    }
    { var_name == "guard":
        ~ return guard_shield
    }
    { var_name == "title":
        ~ return title_shield
    }
    ~ return 0
}
{ member == 4 or member == "scholar":
    { var_name == "life":
        ~ return life_scholar
    }
    { var_name == "life_max":
        ~ return life_max_scholar
    }
    { var_name == "might":
        ~ return might_scholar
    }
    { var_name == "guard":
        ~ return guard_scholar
    }
    { var_name == "title":
        ~ return title_scholar
    }
    ~ return 0
}
{ var_name == "title":
    ~ return ""
}
~ return 0

=== function party_count(var_name, match) ===
~ temp matches = 0
{ var_name == "life":
    { life_blade == match:
        ~ matches = matches + 1
    }
    { life_archer == match:
        ~ matches = matches + 1
    }
    { life_shield == match:
        ~ matches = matches + 1
    }
    { life_scholar == match:
        ~ matches = matches + 1
    }
}
{ var_name == "life_max":
    { life_max_blade == match:
        ~ matches = matches + 1
    }
    { life_max_archer == match:
        ~ matches = matches + 1
    }
    { life_max_shield == match:
        ~ matches = matches + 1
    }
    { life_max_scholar == match:
        ~ matches = matches + 1
    }
}
{ var_name == "might":
    { might_blade == match:
        ~ matches = matches + 1
    }
    { might_archer == match:
        ~ matches = matches + 1
    }
    { might_shield == match:
        ~ matches = matches + 1
    }
    { might_scholar == match:
        ~ matches = matches + 1
    }
}
{ var_name == "guard":
    { guard_blade == match:
        ~ matches = matches + 1
    }
    { guard_archer == match:
        ~ matches = matches + 1
    }
    { guard_shield == match:
        ~ matches = matches + 1
    }
    { guard_scholar == match:
        ~ matches = matches + 1
    }
}
{ var_name == "title":
    { title_blade == match:
        ~ matches = matches + 1
    }
    { title_archer == match:
        ~ matches = matches + 1
    }
    { title_shield == match:
        ~ matches = matches + 1
    }
    { title_scholar == match:
        ~ matches = matches + 1
    }
}
~ return matches

EXTERNAL check(skill, difficulty)

// Loads a character's preset by id: pick_character("crew")
=== function pick_character(who) ===
{ who == "crew":
    ~ character = crew
    ~ wits = 0
}

// A skill's current level, by name.
=== function skill_level(skill) ===
{ skill == "wits":
    ~ return wits
}
~ return 0

// Without the engine there are no dice or modifiers: the average roll (7) decides.
=== function check(skill, difficulty) ===
{ skill_level(skill) + 7 >= difficulty:
    ~ return 3
}
~ return 1

// Dice outside a check: {roll("2d6+3")} → the total.
EXTERNAL roll_dice(formula, label)

=== function roll(formula) ===
~ return roll_dice(formula, "")

// Without the engine the dice are flat: each table's average, 1 for anything else.
=== function roll_dice(formula, label) ===
{ formula == "1d6":
    ~ return 4
}
~ return 1

// Tables: {table("rooms")} rolls and reads a row; table_roll(name) is the total alone, table_text/table_id(name, total) look a total up.
=== function table_roll(name) ===
{ name == "rooms":
    ~ return roll_dice("1d6", "rooms")
}
{ name == "shallow":
    ~ return roll_dice("1d6", "shallow")
}
{ name == "deep":
    ~ return roll_dice("1d6", "deep")
}
~ return 0
EXTERNAL table_text(name, total)
EXTERNAL table_id(name, total)

=== function table_text(name, total) ===
{ name == "rooms" and total <= 1:
    ~ return t("一间空屋子", "an empty room")
}
{ name == "rooms" and total <= 3:
    ~ return t("有东西在里面", "something is in here")
}
{ name == "rooms" and total <= 4:
    ~ return t("一只落满灰的箱子", "a dusty chest")
}
{ name == "rooms" and total <= 5:
    ~ return t("地上的石板松了", "a loose flagstone")
}
{ name == "rooms":
    ~ return t("一座古老的祭坛", "an old shrine")
}
{ name == "shallow" and total <= 2:
    ~ return t("一群巨鼠", "a pack of giant rats")
}
{ name == "shallow" and total <= 4:
    ~ return t("几个地精", "some goblins")
}
{ name == "shallow" and total <= 5:
    ~ return t("两具骷髅", "two skeletons")
}
{ name == "shallow":
    ~ return t("一个邪教徒", "a cultist")
}
{ name == "deep" and total <= 2:
    ~ return t("一队骷髅", "a file of skeletons")
}
{ name == "deep" and total <= 3:
    ~ return t("两个邪教徒", "two cultists")
}
{ name == "deep" and total <= 4:
    ~ return t("一只食尸鬼", "a ghoul")
}
{ name == "deep" and total <= 5:
    ~ return t("一个食人魔", "an ogre")
}
{ name == "deep":
    ~ return t("一个怨灵", "a wraith")
}
~ return ""

=== function table_id(name, total) ===
{ name == "rooms" and total <= 1:
    ~ return "empty"
}
{ name == "rooms" and total <= 3:
    ~ return "monsters"
}
{ name == "rooms" and total <= 4:
    ~ return "treasure"
}
{ name == "rooms" and total <= 5:
    ~ return "trap"
}
{ name == "rooms":
    ~ return "shrine"
}
{ name == "shallow" and total <= 2:
    ~ return ""
}
{ name == "shallow" and total <= 4:
    ~ return ""
}
{ name == "shallow" and total <= 5:
    ~ return ""
}
{ name == "shallow":
    ~ return ""
}
{ name == "deep" and total <= 2:
    ~ return ""
}
{ name == "deep" and total <= 3:
    ~ return ""
}
{ name == "deep" and total <= 4:
    ~ return ""
}
{ name == "deep" and total <= 5:
    ~ return ""
}
{ name == "deep":
    ~ return ""
}
~ return ""

=== function table(name) ===
~ return table_text(name, table_roll(name))

// Entities: spawn("foe", "<template>") gives the new id; stat(id, "<stat>"), set_stat(id, "<stat>", v), add_stat(id, "<stat>", d),
// despawn(id), alive("foe"), pick_one("foe", "random" | "first" | "last" | "lowest:<stat>" | "highest:<stat>"), nth_one("foe", k), name_of(id).
VAR foe = ""
VAR foe_n = 0
EXTERNAL ent_spawn(kind_store, kind, template, who_id)
EXTERNAL ent_has(kind_store, who_id)
EXTERNAL ent_get(kind_store, who_id, stat_id)
EXTERNAL ent_set(kind_store, who_id, stat_id, amount, how)
EXTERNAL ent_drop(kind_store, who_id)
EXTERNAL ent_count(kind_store)
EXTERNAL ent_at(kind_store, amount)
EXTERNAL ent_pick(kind_store, how)
EXTERNAL ent_name(kind_store, kind, who_id)

// Without the engine: nothing is spawned, so every store stays empty.
=== function ent_spawn(kind_store, kind, template, who_id) ===
~ return kind_store
=== function ent_has(kind_store, who_id) ===
~ return false
=== function ent_get(kind_store, who_id, stat_id) ===
~ return 0
=== function ent_set(kind_store, who_id, stat_id, amount, how) ===
~ return kind_store
=== function ent_drop(kind_store, who_id) ===
~ return kind_store
=== function ent_count(kind_store) ===
~ return 0
=== function ent_at(kind_store, amount) ===
~ return ""
=== function ent_pick(kind_store, how) ===
~ return ""
=== function ent_name(kind_store, kind, who_id) ===
~ return who_id

=== function spawn(kind, template) ===
~ temp new_id = ""
{ kind == "foe":
    ~ foe_n = foe_n + 1
    ~ new_id = template + "_" + foe_n
    ~ foe = ent_spawn(foe, "foe", template, new_id)
    { ent_has(foe, new_id):
        ~ return new_id
    }
}
~ return ""

=== function stat(who_id, stat_id) ===
{ who_id == "blade":
    { stat_id == "life":
        ~ return life_blade
    }
    { stat_id == "life_max":
        ~ return life_max_blade
    }
    { stat_id == "might":
        ~ return might_blade
    }
    { stat_id == "guard":
        ~ return guard_blade
    }
    ~ return 0
}
{ who_id == "archer":
    { stat_id == "life":
        ~ return life_archer
    }
    { stat_id == "life_max":
        ~ return life_max_archer
    }
    { stat_id == "might":
        ~ return might_archer
    }
    { stat_id == "guard":
        ~ return guard_archer
    }
    ~ return 0
}
{ who_id == "shield":
    { stat_id == "life":
        ~ return life_shield
    }
    { stat_id == "life_max":
        ~ return life_max_shield
    }
    { stat_id == "might":
        ~ return might_shield
    }
    { stat_id == "guard":
        ~ return guard_shield
    }
    ~ return 0
}
{ who_id == "scholar":
    { stat_id == "life":
        ~ return life_scholar
    }
    { stat_id == "life_max":
        ~ return life_max_scholar
    }
    { stat_id == "might":
        ~ return might_scholar
    }
    { stat_id == "guard":
        ~ return guard_scholar
    }
    ~ return 0
}
{ ent_has(foe, who_id):
    ~ return ent_get(foe, who_id, stat_id)
}
~ return 0

=== function set_stat(who_id, stat_id, amount) ===
{ who_id == "blade":
    { stat_id == "life":
        ~ life_blade = amount
    }
    { stat_id == "life_max":
        ~ life_max_blade = amount
    }
    { stat_id == "might":
        ~ might_blade = amount
    }
    { stat_id == "guard":
        ~ guard_blade = amount
    }
    ~ return
}
{ who_id == "archer":
    { stat_id == "life":
        ~ life_archer = amount
    }
    { stat_id == "life_max":
        ~ life_max_archer = amount
    }
    { stat_id == "might":
        ~ might_archer = amount
    }
    { stat_id == "guard":
        ~ guard_archer = amount
    }
    ~ return
}
{ who_id == "shield":
    { stat_id == "life":
        ~ life_shield = amount
    }
    { stat_id == "life_max":
        ~ life_max_shield = amount
    }
    { stat_id == "might":
        ~ might_shield = amount
    }
    { stat_id == "guard":
        ~ guard_shield = amount
    }
    ~ return
}
{ who_id == "scholar":
    { stat_id == "life":
        ~ life_scholar = amount
    }
    { stat_id == "life_max":
        ~ life_max_scholar = amount
    }
    { stat_id == "might":
        ~ might_scholar = amount
    }
    { stat_id == "guard":
        ~ guard_scholar = amount
    }
    ~ return
}
{ ent_has(foe, who_id):
    ~ foe = ent_set(foe, who_id, stat_id, amount, "life")
    ~ return
}

=== function add_stat(who_id, stat_id, amount) ===
~ set_stat(who_id, stat_id, stat(who_id, stat_id) + amount)

=== function despawn(who_id) ===
{ who_id == "blade":
    ~ return
}
{ who_id == "archer":
    ~ return
}
{ who_id == "shield":
    ~ return
}
{ who_id == "scholar":
    ~ return
}
{ ent_has(foe, who_id):
    ~ foe = ent_drop(foe, who_id)
    ~ return
}

=== function alive(kind) ===
~ temp pick_no = 0
{ kind == "party":
    ~ pick_no = 0
    { life_blade > 0:
        ~ pick_no = pick_no + 1
    }
    { life_archer > 0:
        ~ pick_no = pick_no + 1
    }
    { life_shield > 0:
        ~ pick_no = pick_no + 1
    }
    { life_scholar > 0:
        ~ pick_no = pick_no + 1
    }
    ~ return pick_no
}
{ kind == "foe":
    ~ return ent_count(foe)
}
~ return 0

=== function pick_one(kind, how) ===
~ temp pick_no = 0
~ temp new_id = ""
{ kind == "party":
    ~ pick_no = 0
    { life_blade > 0:
        ~ pick_no = pick_no + 1
    }
    { life_archer > 0:
        ~ pick_no = pick_no + 1
    }
    { life_shield > 0:
        ~ pick_no = pick_no + 1
    }
    { life_scholar > 0:
        ~ pick_no = pick_no + 1
    }
    { pick_no <= 0:
        ~ return ""
    }
    { how == "lowest:life":
        ~ new_id = ""
        { life_blade > 0 and (new_id == "" or life_blade < stat(new_id, "life")):
            ~ new_id = "blade"
        }
        { life_archer > 0 and (new_id == "" or life_archer < stat(new_id, "life")):
            ~ new_id = "archer"
        }
        { life_shield > 0 and (new_id == "" or life_shield < stat(new_id, "life")):
            ~ new_id = "shield"
        }
        { life_scholar > 0 and (new_id == "" or life_scholar < stat(new_id, "life")):
            ~ new_id = "scholar"
        }
        ~ return new_id
    }
    { how == "lowest:life_max":
        ~ new_id = ""
        { life_blade > 0 and (new_id == "" or life_max_blade < stat(new_id, "life_max")):
            ~ new_id = "blade"
        }
        { life_archer > 0 and (new_id == "" or life_max_archer < stat(new_id, "life_max")):
            ~ new_id = "archer"
        }
        { life_shield > 0 and (new_id == "" or life_max_shield < stat(new_id, "life_max")):
            ~ new_id = "shield"
        }
        { life_scholar > 0 and (new_id == "" or life_max_scholar < stat(new_id, "life_max")):
            ~ new_id = "scholar"
        }
        ~ return new_id
    }
    { how == "lowest:might":
        ~ new_id = ""
        { life_blade > 0 and (new_id == "" or might_blade < stat(new_id, "might")):
            ~ new_id = "blade"
        }
        { life_archer > 0 and (new_id == "" or might_archer < stat(new_id, "might")):
            ~ new_id = "archer"
        }
        { life_shield > 0 and (new_id == "" or might_shield < stat(new_id, "might")):
            ~ new_id = "shield"
        }
        { life_scholar > 0 and (new_id == "" or might_scholar < stat(new_id, "might")):
            ~ new_id = "scholar"
        }
        ~ return new_id
    }
    { how == "lowest:guard":
        ~ new_id = ""
        { life_blade > 0 and (new_id == "" or guard_blade < stat(new_id, "guard")):
            ~ new_id = "blade"
        }
        { life_archer > 0 and (new_id == "" or guard_archer < stat(new_id, "guard")):
            ~ new_id = "archer"
        }
        { life_shield > 0 and (new_id == "" or guard_shield < stat(new_id, "guard")):
            ~ new_id = "shield"
        }
        { life_scholar > 0 and (new_id == "" or guard_scholar < stat(new_id, "guard")):
            ~ new_id = "scholar"
        }
        ~ return new_id
    }
    { how == "highest:life":
        ~ new_id = ""
        { life_blade > 0 and (new_id == "" or life_blade > stat(new_id, "life")):
            ~ new_id = "blade"
        }
        { life_archer > 0 and (new_id == "" or life_archer > stat(new_id, "life")):
            ~ new_id = "archer"
        }
        { life_shield > 0 and (new_id == "" or life_shield > stat(new_id, "life")):
            ~ new_id = "shield"
        }
        { life_scholar > 0 and (new_id == "" or life_scholar > stat(new_id, "life")):
            ~ new_id = "scholar"
        }
        ~ return new_id
    }
    { how == "highest:life_max":
        ~ new_id = ""
        { life_blade > 0 and (new_id == "" or life_max_blade > stat(new_id, "life_max")):
            ~ new_id = "blade"
        }
        { life_archer > 0 and (new_id == "" or life_max_archer > stat(new_id, "life_max")):
            ~ new_id = "archer"
        }
        { life_shield > 0 and (new_id == "" or life_max_shield > stat(new_id, "life_max")):
            ~ new_id = "shield"
        }
        { life_scholar > 0 and (new_id == "" or life_max_scholar > stat(new_id, "life_max")):
            ~ new_id = "scholar"
        }
        ~ return new_id
    }
    { how == "highest:might":
        ~ new_id = ""
        { life_blade > 0 and (new_id == "" or might_blade > stat(new_id, "might")):
            ~ new_id = "blade"
        }
        { life_archer > 0 and (new_id == "" or might_archer > stat(new_id, "might")):
            ~ new_id = "archer"
        }
        { life_shield > 0 and (new_id == "" or might_shield > stat(new_id, "might")):
            ~ new_id = "shield"
        }
        { life_scholar > 0 and (new_id == "" or might_scholar > stat(new_id, "might")):
            ~ new_id = "scholar"
        }
        ~ return new_id
    }
    { how == "highest:guard":
        ~ new_id = ""
        { life_blade > 0 and (new_id == "" or guard_blade > stat(new_id, "guard")):
            ~ new_id = "blade"
        }
        { life_archer > 0 and (new_id == "" or guard_archer > stat(new_id, "guard")):
            ~ new_id = "archer"
        }
        { life_shield > 0 and (new_id == "" or guard_shield > stat(new_id, "guard")):
            ~ new_id = "shield"
        }
        { life_scholar > 0 and (new_id == "" or guard_scholar > stat(new_id, "guard")):
            ~ new_id = "scholar"
        }
        ~ return new_id
    }
    {
    - how == "first" or pick_no == 1:
        ~ pick_no = 1
    - how == "last":
        ~ pick_no = pick_no
    - how == "random":
        ~ pick_no = roll_dice("1d" + pick_no, "pick:party")
    - else:
        ~ pick_no = 0
    }
    ~ return nth_one(kind, pick_no)
}
{ kind == "foe":
    { how == "random":
        ~ pick_no = ent_count(foe)
        { pick_no <= 0:
            ~ return ""
        }
        { pick_no == 1:
            ~ return ent_at(foe, 1)
        }
        ~ return ent_at(foe, roll_dice("1d" + pick_no, "pick:foe"))
    }
    ~ return ent_pick(foe, how)
}
~ return ""

=== function nth_one(kind, amount) ===
~ temp pick_no = 0
{ kind == "party":
    ~ pick_no = 0
    { life_blade > 0:
        ~ pick_no = pick_no + 1
        { pick_no == amount:
            ~ return "blade"
        }
    }
    { life_archer > 0:
        ~ pick_no = pick_no + 1
        { pick_no == amount:
            ~ return "archer"
        }
    }
    { life_shield > 0:
        ~ pick_no = pick_no + 1
        { pick_no == amount:
            ~ return "shield"
        }
    }
    { life_scholar > 0:
        ~ pick_no = pick_no + 1
        { pick_no == amount:
            ~ return "scholar"
        }
    }
    ~ return ""
}
{ kind == "foe":
    ~ return ent_at(foe, amount)
}
~ return ""

=== function name_of(who_id) ===
{ who_id == "blade":
    ~ return t("剑手", "Blade")
}
{ who_id == "archer":
    ~ return t("弓手", "Archer")
}
{ who_id == "shield":
    ~ return t("盾卫", "Shield")
}
{ who_id == "scholar":
    ~ return t("学者", "Scholar")
}
{ ent_has(foe, who_id):
    ~ return ent_name(foe, "foe", who_id)
}
~ return who_id

// Table rows that spawn: ~ temp row_no = spawn_from("shallow") spawns what the roll's row says and gives the total ({table_text("shallow", row_no)} tells it).
=== function spawn_from(name) ===
~ temp row_no = table_roll(name)
~ spawn_row(name, row_no)
~ return row_no

=== function spawn_row(name, total) ===
{ name == "shallow" and total <= 2:
    ~ return spawn_times(name, total, roll("d3+1"))
}
{ name == "shallow" and total <= 4:
    ~ return spawn_times(name, total, roll("d2+1"))
}
{ name == "shallow" and total <= 5:
    ~ return spawn_times(name, total, 2)
}
{ name == "shallow":
    ~ return spawn_times(name, total, 1)
}
{ name == "deep" and total <= 2:
    ~ return spawn_times(name, total, roll("d2+1"))
}
{ name == "deep" and total <= 3:
    ~ return spawn_times(name, total, 2)
}
{ name == "deep" and total <= 4:
    ~ return spawn_times(name, total, 1)
}
{ name == "deep" and total <= 5:
    ~ return spawn_times(name, total, 1)
}
{ name == "deep":
    ~ return spawn_times(name, total, 1)
}
~ return 0

=== function spawn_row_one(name, total) ===
~ temp new_id = ""
{ name == "shallow" and total <= 2:
    ~ new_id = spawn("foe", "rat")
    ~ return new_id
}
{ name == "shallow" and total <= 4:
    ~ new_id = spawn("foe", "goblin")
    ~ return new_id
}
{ name == "shallow" and total <= 5:
    ~ new_id = spawn("foe", "skeleton")
    ~ return new_id
}
{ name == "shallow":
    ~ new_id = spawn("foe", "cultist")
    ~ return new_id
}
{ name == "deep" and total <= 2:
    ~ new_id = spawn("foe", "skeleton")
    ~ return new_id
}
{ name == "deep" and total <= 3:
    ~ new_id = spawn("foe", "cultist")
    ~ return new_id
}
{ name == "deep" and total <= 4:
    ~ new_id = spawn("foe", "ghoul")
    ~ return new_id
}
{ name == "deep" and total <= 5:
    ~ new_id = spawn("foe", "ogre")
    ~ return new_id
}
{ name == "deep":
    ~ new_id = spawn("foe", "wraith")
    ~ return new_id
}
~ return ""

=== function spawn_times(name, total, amount) ===
{ amount <= 0:
    ~ return 0
}
~ spawn_row_one(name, total)
~ return 1 + spawn_times(name, total, amount - 1)
