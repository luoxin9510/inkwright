{
  "name": "inkwright",
  "version": "0.3.0",
  "description": "Write, playtest and debug ink interactive fiction: live play panel, saves, knot graph, web export and bilingual stories. English and Chinese interface.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "check-ink": "esbuild scripts/check-ink.ts --bundle --platform=node --format=esm --outfile=.cache/check-ink.mjs --log-level=error && node .cache/check-ink.mjs",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "happy-dom": "^21.0.4",
    "obsidian": "latest",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "inkjs": "^2.4.0"
  }
}
